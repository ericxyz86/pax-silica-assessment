    },
    {
      "id": "px-21-capital",
      "scene": 5,
      "sceneName": "capital",
      "start": 112.9,
      "audio": 7.2,
      "text": "Their own pairing implies under five thousand jobs per billion dollars. No facility delivers both.",
      "slot": 8.6
    },
    {
      "id": "px-22-lease",
      "scene": 6,
      "sceneName": "lease",
      "start": 122.1,
      "audio": 6.88,
      "text": "Sixteen hundred hectares of public land, for twenty five years, with options reaching ninety nine.",
