    {
      "id": "px-05-signed",
      "scene": 1,
      "sceneName": "signed",
      "start": 25.7,
      "audio": 4.24,
      "text": "Fifteen of the sixteen implementation gates are still open.",
      "slot": 5.8
    },
    {
      "id": "px-06-claimed",
      "scene": 2,
      "sceneName": "claimed",
      "start": 32.1,
      "audio": 4.32,
      "text": "Now the claims. Forty to seventy billion US dollars of investment.",
      "slot": 4.9
    },
    {
      "id": "px-07-claimed",
      "scene": 2,
      "sceneName": "claimed",
      "start": 37,
      "audio": 4.24,
      "text": "And a hundred and thirty to a hundred and ninety thousand direct jobs.",
