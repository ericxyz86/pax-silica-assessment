    },
    {
      "id": "px-11-water",
      "scene": 3,
      "sceneName": "water",
      "start": 56.6,
      "audio": 6.72,
      "text": "At ninety million litres a day, rainfall harvesting needs three thousand one hundred and forty four hectares.",
      "slot": 7.3
    },
    {
      "id": "px-12-water",
      "scene": 3,
      "sceneName": "water",
      "start": 63.9,
      "audio": 3.6,
      "text": "That is a hundred and ninety four per cent of the site.",
      "slot": 4.2
    },
    {
      "id": "px-13-water",
      "scene": 3,
      "sceneName": "water",
      "start": 68.1,
      "audio": 5.68,
      "text": "So the water has to come from beyond the boundary, from Tarlac households and farms.",
      "slot": 6.9
    },
    {
      "id": "px-14-jobs",
      "scene": 4,
      "sceneName": "jobs",
      "start": 75.6,
      "audio": 4.16,
      "text": "Then the jobs. B C D A says a hundred and ninety thousand.",
