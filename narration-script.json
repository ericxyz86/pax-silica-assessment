    {
      "id": "px-03-signed",
      "scene": 1,
      "sceneName": "signed",
      "start": 11.6,
      "audio": 7.24,
      "text": "Start with what exists on paper. At the twenty-sixth of July, the investment legally committed is zero.",
      "slot": 7.8
