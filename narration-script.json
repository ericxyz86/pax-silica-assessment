    },
    {
      "id": "px-20-capital",
      "scene": 5,
      "sceneName": "capital",
      "start": 104.6,
      "audio": 7.73,
      "text": "Advanced fabrication takes enormous capital and few workers. Assembly takes many workers and far less capital.",
