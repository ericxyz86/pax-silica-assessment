    {
      "id": "px-08-claimed",
      "scene": 2,
      "sceneName": "claimed",
      "start": 41.8,
      "audio": 4.8,
      "text": "Announced together in the same week. Never shown to work together.",
      "slot": 6.2
    },
    {
      "id": "px-09-water",
      "scene": 3,
      "sceneName": "water",
      "start": 48.6,
      "audio": 3.6,
      "text": "Start with water, because water is arithmetic.",
