    {
      "id": "px-17-jobs",
      "scene": 4,
      "sceneName": "jobs",
      "start": 87.2,
      "audio": 6.16,
      "text": "For comparison, the whole Subic Freeport employs a hundred and seventy one thousand.",
      "slot": 6.7
    },
    {
      "id": "px-18-jobs",
      "scene": 4,
      "sceneName": "jobs",
      "start": 93.9,
      "audio": 5.44,
      "text": "Three claims in five days. The only bottom-up figure is: thousands.",
      "slot": 6.6
    },
    {
      "id": "px-19-capital",
      "scene": 5,
      "sceneName": "capital",
      "start": 101.1,
      "audio": 2.96,
      "text": "And the two headline numbers pull against each other.",
